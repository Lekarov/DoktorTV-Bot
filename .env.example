# ════════════════════════════════════════════════════════════════════
#  DoktorTV Bot — configuration
#  Copie ce fichier en « .env » puis remplis-le.  NE COMMITTE JAMAIS .env
# ════════════════════════════════════════════════════════════════════

# ── Telegram ────────────────────────────────────────────────────────
# Jeton donné par @BotFather (/newbot).  SECRET.
BOT_TOKEN=
# Ton identifiant Telegram (facultatif). Vide = le premier /start devient propriétaire.
OWNER_ID=

# ── Réseau ──────────────────────────────────────────────────────────
# Adresse IP locale du serveur où tournent Radarr, Sonarr, Jellyfin…
NAS_HOST=192.168.1.10
# IP sur laquelle exposer les webhooks (IP locale du serveur, jamais 0.0.0.0 si le port est ouvert sur Internet)
BIND_IP=192.168.1.10
HOOK_PORT=8099
# Chaîne aléatoire qui protège les URL de webhook :  openssl rand -hex 24   SECRET.
HOOK_SECRET=

# ── Dossiers de configuration (lus en LECTURE SEULE pour récupérer les clés API) ──
# contient config.xml
RADARR_CONFIG_DIR=/srv/appdata/radarr
# contient config.xml
SONARR_CONFIG_DIR=/srv/appdata/sonarr
# contient settings.json
SEERR_CONFIG_DIR=/srv/appdata/jellyseerr
# contient config.js (vide = cross-seed non utilisé)
CROSSSEED_CONFIG_DIR=
# stockage des médias (pour l'espace disque)
STORAGE_PATH=/srv/storage

# ── Ports des services (si différents des valeurs par défaut) ──
RADARR_PORT=7878
SONARR_PORT=8989
SEERR_PORT=5055
# JELLYFIN_URL=http://192.168.1.10:8096

# ── Jellyfin ────────────────────────────────────────────────────────
# Tableau de bord → Clés API → +.  SECRET.
JELLYFIN_KEY=

# ── Transmission (menu 🧲) ──────────────────────────────────────────
# TRANSMISSION_URL=http://192.168.1.10:9091/transmission/rpc
TRANSMISSION_USER=
# SECRET
TRANSMISSION_PASS=

# ── Purgearr (menu 🧹, facultatif) ──────────────────────────────────
# PURGEARR_URL=http://192.168.1.10:7979

# ── cross-seed (menu 🔁, facultatif) ────────────────────────────────
CROSSSEED_CONTAINER=cross-seed
CROSSSEED_PORT=2468

# ── Alertes ─────────────────────────────────────────────────────────
DISK_ALERT_PCT=90
